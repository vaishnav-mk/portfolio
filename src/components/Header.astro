---
import SocialLinks from "./SocialLinks.svelte";

const { name, title, byline, description, sections, socialLinks, easterEgg, currentWork } = Astro.props;

const navItems = sections.map((section, index) => ({
  key: section.toLowerCase(),
  index: index + 1,
  label: section.charAt(0).toUpperCase() + section.slice(1),
}));
---

<div
  class="flex flex-col justify-between w-full max-w-xs md:w-1/3 md:max-w-full md:fixed mb-12"
>
  <div class="flex flex-col space-y-4 mb-12 md:mb-24">
    <p class="leading-relaxed text-sunrise">Hi, my name is</p>
    <div class="hover-container">
      <h1 class="text-3xl font-bold leading-tight lg:text-6xl text-zenith">
        <span class="sr-only">{name}</span>
        <span aria-hidden="true" class="block overflow-hidden group relative">
          <span
            class="inline-block transition-all duration-300 ease-in-out group-hover:-translate-y-full pb-2"
          >
            {
              name.split("").map((letter, index) => (
                <span
                  class="inline-block"
                  style={{ transitionDelay: `${index * 25}ms` }}
                >
                  {letter === " " ? "\u00A0" : letter}
                </span>
              ))
            }
          </span>
          <span
            class="inline-block absolute left-0 top-0 transition-all duration-300 ease-in-out translate-y-full group-hover:translate-y-0 pb-2"
          >
            {
              "wishee".split("").map((letter, index) => (
                <span
                  class="inline-block"
                  style={{ transitionDelay: `${index * 25}ms` }}
                >
                  {letter}
                </span>
              ))
            }
          </span>
        </span>
      </h1>
    </div>

    <h1 class="font-bold leading-tight lg:text-3xl text-zenith opacity-50">
      {byline}
    </h1>
    <p class="leading-relaxed opacity-50">{description}</p>
    <p class="text-sunrise font-semibold">
      Currently working as an {currentWork.position} at <a
        href={currentWork.companyLink}
        class="underline font-bold decoration-wavy underline-offset-4 decoration-2"
        >{currentWork.company}</a
      >
    </p>
    
  </div>

  <nav class="hidden md:mt- md:block md:mb-16">
    <ul class="flex flex-col space-y-8" id="nav">
      {
        navItems.map((item) => (
          <li>
            <a
              class="flex items-center space-x-4 hover:text-[#F4F4F4] transition duration-300 font-bold text-[#A5A5A7] group"
              href={`#${item.key}`}
            >
              <span class="text-xs text-sunrise">.0{item.index}</span>
              <span class="block h-px bg-zenith transition-all duration-300 w-12 group-hover:w-24" />
              <span class="text-sm uppercase">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <SocialLinks links={socialLinks} client:load />
</div>

<script>
  import { viewing } from "../store.js";

  viewing.subscribe((value) => {
    const navLinks = document.querySelectorAll("nav a");
    navLinks.forEach((link) => {
      const bar = link.querySelector("span.h-px");
      const isActive = link.getAttribute("href") === `#${value}`;

      link.classList.remove("text-zenith");
      bar.classList.remove("w-24");

      if (isActive) {
        link.classList.remove("text-[#A5A5A7]");
        link.classList.add("text-zenith");
        bar.classList.remove("w-12");
        bar.classList.add("w-24");
      } else {
        bar.classList.add("w-12");
        link.classList.add("text-[#A5A5A7]");
      }
    });
  });
</script>
