---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Projects from "../components/Projects.astro";
import Experiences from "../components/Experiences.astro";
import Blogs from "../components/Blogs.svelte";
import data from "../data.json";
---

<Layout title="~vm">
  <div
    class="fixed gap-5 rotate-90 justify-center flex z-10 h-32 text-white rotate-email hidden lg:flex"
  >
    <span
      class="text-sm lowercase font-bold font-mono text-sunrise rotate-180 tracking-widest hover:text-zenith transition-all duration-300 hover:-translate-x-2"
    >
      <a href={`mailto:${data.portfolio.email}`}>{data.portfolio.email}</a>
    </span>
    <span
      class="block h-px bg-zenith transition-all duration-300 w-96 group-hover:w-24"
    ></span>
  </div>

  <div
    class="relative flex flex-col w-screen mx-auto font-sans text-base max-w-1440 text-dawn md:flex-row md:py-[88px] p-8 shadow-inner shadow-2xl"
  >
    <div class="max-h-screen h-auto w-full md:w-1/3 md:max-w-xs md:fixed">
      <Header
        name={data.portfolio.name}
        title={data.portfolio.title}
        description={data.portfolio.description}
        sections={data.sections.map((section) => section.label)}
        socialLinks={data.socialLinks}
        byline={data.byline}
        easterEgg={data.easterEgg}
      />
    </div>

    <div class="relative w-full md:ml-auto md:w-2/5 flex flex-col space-y-16">
      <Experiences experiences={data.experiences} />
      <Projects projects={data.projects} />
      <Blogs client:load />
    </div>

    <div
      class="fixed top-0 left-0 z-20 w-full h-32 pointer-events-none gradient-to-b from-night to-transparent"
    >
    </div>
  </div>
</Layout>

<style>
  .rotate-email {
    transform: rotate(90deg);
    transform-origin: left bottom;
    white-space: nowrap;
    left: 10px;
    bottom: 35%;
    align-items: center;
  }

  main {
    margin: auto;
    padding: 1rem;
    max-width: calc(100% - 2rem);
    color: #0e0c0e;
    font-size: 20px;
    line-height: 1.6;
  }
</style>

<script>
  import { viewing } from "../store.js";
  const sections = document.querySelectorAll("section");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.id;

        if (entry.isIntersecting) {
          viewing.set(id);
        }
      });
    },
    { threshold: 0.5 }
  );

  sections.forEach((section) => {
    observer.observe(section);
  });
</script>
