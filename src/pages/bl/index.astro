---
import Layout from "../../layouts/Layout.astro";
import { formatDistanceToNow } from "date-fns";
import { bucketListItems as bucketListItemsData } from "../../bucketlist.json";

const bucketListItems = bucketListItemsData;
const startDate = "2024-02-24";
const futureDate = new Date("2024-02-24");
futureDate.setFullYear(futureDate.getFullYear() + 10);
const timeLeft = formatDistanceToNow(futureDate, { addSuffix: true });
---

<Layout title="~vm | Bucket List">
  <main class="min-h-screen bg-night px-4 py-8 md:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="sticky top-0 bg-night/80 backdrop-blur-sm rounded-lg mb-4 z-10 drop-shadow-3xl pb-4 shadow-xl">
        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between">
            <div class="w-full">
              <h1 class="text-3xl font-bold text-zenith">Bucket List</h1>
              <div class="flex justify-between mt-2 space-x-3 w-full">
                <p class="text-sm text-dawn">
                  Started
                  <span class="text-sunrise font-mono cursor-help border-b border-dotted border-sunrise" title="on my 21st birthday">
                    {startDate} (age 21)
                  </span>
                </p>
                <span class="text-dawn">•</span>
                <a href="https://ashotoftheworld.com/home/the-ultimate-bucket-list/" target="_blank" rel="noopener noreferrer" class="text-sm text-sunrise hover:text-zenith transition-colors duration-300 flex items-center space-x-1">
                  <span>The ultimate list (Inspiration)</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
                <span class="text-dawn">•</span>
                <p class="text-sm text-dawn">
                  Ends
                  <span class="text-sunrise font-mono cursor-help border-b border-dotted border-sunrise" title="on my 31st birthday">
                    {timeLeft} (age 31)
                  </span>
                </p>
              </div>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <div class="flex-1">
              <div class="w-full bg-dusk h-2 rounded-full">
                <div id="progress-bar" class="bg-sunrise h-full rounded-full transition-all duration-500" style={`width: ${(bucketListItems.filter(item => item.checked).length / bucketListItems.length) * 100}%`}></div>
              </div>
            </div>
            <span id="progress-text" class="text-sunrise font-mono text-sm">
              {bucketListItems.filter(item => item.checked).length}/{bucketListItems.length} completed
            </span>
          </div>
          <div class="flex justify-between items-center">
            <button id="submit-changes" class="bg-dusk/50 text-dawn py-1 px-3 rounded-lg hover:bg-sunrise hover:text-night transition-colors duration-300 text-sm hidden">
              Save Changes (<span id="changes-count">0</span>)
            </button>
            <button id="toggle-add-form" class="bg-sunrise text-night py-1 px-3 rounded-lg hover:bg-zenith transition-colors duration-300 text-sm ml-auto">
              + Add New
            </button>
          </div>
          <div id="add-form" class="bg-dusk/30 p-4 rounded-lg space-y-3 hidden">
            <div>
              <label for="newItemLabel" class="block text-sm text-dawn mb-1">Item:</label>
              <input id="newItemLabel" type="text" placeholder="What do you want to achieve?" class="w-full bg-night text-zenith border border-dusk rounded-lg px-3 py-2" />
            </div>
            <div>
              <label for="newItemInfo" class="block text-sm text-dawn mb-1">Details:</label>
              <input id="newItemInfo" type="text" placeholder="Any additional details" class="w-full bg-night text-zenith border border-dusk rounded-lg px-3 py-2" />
            </div>
            <button id="add-item-button" class="bg-sunrise text-night py-2 px-4 rounded-lg hover:bg-zenith transition-colors duration-300">
              Add to Bucket List
            </button>
          </div>
        </div>
      </div>

      <div id="bucket-list-container" class="space-y-2">
        {bucketListItems.map((item, index) => (
          <div class="flex items-center">
            <label class="block cursor-pointer flex-grow">
              <div class="group bg-dusk/30 hover:bg-dusk/50 rounded-lg px-4 py-3 transition-all duration-300 hover:-translate-x-2">
                <div class="flex items-center space-x-3">
                  <input type="checkbox" checked={item.checked} data-id={index} class="item-checkbox w-4 h-4 rounded border-2 border-sunrise bg-transparent checked:bg-sunrise transition-colors duration-300" />
                  <div class="flex items-center space-x-2 min-w-0">
                    <span class={`font-medium text-zenith ${item.checked ? 'line-through opacity-50' : ''}`}>{item.label}</span>
                    <span class="text-dawn opacity-50">•</span>
                    <span class={`text-sm text-dawn ${item.checked ? 'line-through opacity-50' : ''}`}>{item.info}</span>
                  </div>
                </div>
              </div>
            </label>
            <button class="delete-button ml-2 p-2 text-dawn hover:text-sunrise transition-colors" data-id={index} title="Delete item">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
    <div id="password-popup" class="fixed bottom-0 left-0 right-0 bg-dusk/95 backdrop-blur-sm p-4 shadow-xl flex flex-col items-start z-20 hidden w-full transition-all duration-300 transform translate-y-full border-t border-sunrise/30">
      <div class="max-w-3xl mx-auto w-full">
        <div class="flex justify-between items-center mb-3">
          <p class="text-zenith text-sm font-medium">Please confirm changes</p>
          <div class="text-xs text-dawn bg-night/50 px-2 py-1 rounded-md" id="change-counter">
            <span id="changes-summary">No changes</span>
          </div>
        </div>
        <div id="changes-list" class="max-h-32 overflow-y-auto bg-night/40 rounded-lg p-2 mb-3 text-xs text-dawn">
          <div class="text-center text-dawn/50 italic">No pending changes</div>
        </div>
        <div class="flex w-full space-x-2">
          <input id="password-input" type="password" placeholder="Password" class="flex-grow bg-night/80 text-zenith border border-dawn/30 rounded-lg px-3 py-2 text-sm focus:border-sunrise focus:outline-none transition-colors duration-300" />
          <button id="submit-password" class="bg-sunrise text-night px-4 py-2 rounded-lg text-sm hover:bg-zenith transition-colors duration-300 font-medium">
            Save All
          </button>
          <button id="cancel-password" class="bg-night/50 border border-dawn/30 text-dawn px-4 py-2 rounded-lg text-sm hover:border-sunrise hover:text-sunrise transition-colors duration-300">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  let originalItems = Array.from(document.querySelectorAll('.item-checkbox')).map((checkbox, index) => {
    const item = checkbox.closest('.group');
    const label = item.querySelector('.font-medium').textContent.trim();
    const info = item.querySelector('.text-sm').textContent.trim();
    const checked = checkbox.checked;
    return { label, info, checked, id: index };
  });
  
  let bucketListItems = JSON.parse(JSON.stringify(originalItems));
  let pendingChanges = [];
  
  const progressBar = document.getElementById('progress-bar');
  const progressText = document.getElementById('progress-text');
  const addFormToggle = document.getElementById('toggle-add-form');
  const addForm = document.getElementById('add-form');
  const addItemButton = document.getElementById('add-item-button');
  const passwordPopup = document.getElementById('password-popup');
  const passwordInput = document.getElementById('password-input');
  const submitPasswordButton = document.getElementById('submit-password');
  const cancelPasswordButton = document.getElementById('cancel-password');
  const bucketListContainer = document.getElementById('bucket-list-container');
  const submitChangesButton = document.getElementById('submit-changes');
  const changesCount = document.getElementById('changes-count');
  const changesList = document.getElementById('changes-list');
  const changesSummary = document.getElementById('changes-summary');
  
  document.querySelectorAll('.item-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', (e) => {
      const id = parseInt(e.target.dataset.id);
      toggleItem(id, e.target.checked);
    });
  });
  
  document.querySelectorAll('.delete-button').forEach(button => {
    button.addEventListener('click', (e) => {
      const id = parseInt(e.target.closest('.delete-button').dataset.id);
      deleteItem(id);
    });
  });
  
  addFormToggle.addEventListener('click', () => {
    const isVisible = !addForm.classList.contains('hidden');
    if (isVisible) {
      addForm.classList.add('hidden');
      addFormToggle.textContent = '+ Add New';
    } else {
      addForm.classList.remove('hidden');
      addFormToggle.textContent = 'Cancel';
    }
  });
  
  addItemButton.addEventListener('click', () => {
    const label = document.getElementById('newItemLabel').value.trim();
    const info = document.getElementById('newItemInfo').value.trim();
    if (!label) return;
    addItem(label, info);
    document.getElementById('newItemLabel').value = '';
    document.getElementById('newItemInfo').value = '';
  });
  
  submitPasswordButton.addEventListener('click', submitChanges);
  cancelPasswordButton.addEventListener('click', cancelChanges);
  submitChangesButton.addEventListener('click', showPasswordPopup);
  
  function toggleItem(id, checked) {
    const item = document.querySelector(`input[data-id="${id}"]`).closest('.group');
    const labelEl = item.querySelector('.font-medium');
    const infoEl = item.querySelector('.text-sm');
    if (checked) {
      labelEl.classList.add('line-through', 'opacity-50');
      infoEl.classList.add('line-through', 'opacity-50');
    } else {
      labelEl.classList.remove('line-through', 'opacity-50');
      infoEl.classList.remove('line-through', 'opacity-50');
    }
    const itemIndex = bucketListItems.findIndex(item => item.id === id);
    if (itemIndex !== -1) {
      bucketListItems[itemIndex].checked = checked;
    }
    const existingChange = pendingChanges.findIndex(change => change.type === 'toggle' && change.id === id);
    if (existingChange !== -1) {
      if (originalItems.find(item => item.id === id).checked === checked) {
        pendingChanges.splice(existingChange, 1);
      } else {
        pendingChanges[existingChange].checked = checked;
      }
    } else {
      if (originalItems.find(item => item.id === id).checked !== checked) {
        pendingChanges.push({ type: 'toggle', id, checked, label: labelEl.textContent.trim() });
      }
    }
    updateProgressBar();
    updateChangesUI();
  }
  
  function deleteItem(id) {
    const itemElement = document.querySelector(`input[data-id="${id}"]`).closest('.flex.items-center');
    itemElement.style.opacity = '0.3';
    itemElement.style.transform = 'translateX(20px)';
    const item = bucketListItems.find(item => item.id === id);
    const addIndex = pendingChanges.findIndex(change => change.type === 'add' && change.tempId === id);
    if (addIndex !== -1) {
      pendingChanges.splice(addIndex, 1);
      const itemIndex = bucketListItems.findIndex(item => item.id === id);
      if (itemIndex !== -1) bucketListItems.splice(itemIndex, 1);
      itemElement.remove();
    } else {
      const existingChange = pendingChanges.findIndex(change => change.type === 'delete' && change.id === id);
      if (existingChange === -1) {
        pendingChanges.push({ type: 'delete', id, label: item ? item.label : 'Unknown item' });
      }
    }
    updateProgressBar();
    updateChangesUI();
  }
  
  function addItem(label, info) {
    const tempId = -1 * (pendingChanges.filter(c => c.type === 'add').length + 1);
    const newItem = { id: tempId, label, info, checked: false };
    bucketListItems.push(newItem);
    pendingChanges.push({ type: 'add', tempId, item: newItem, label });
    const newItemHTML = createItemHTML(newItem, tempId);
    bucketListContainer.insertAdjacentHTML('beforeend', newItemHTML);
    const newCheckbox = document.querySelector(`input[data-id="${tempId}"]`);
    newCheckbox.addEventListener('change', (e) => {
      toggleItem(tempId, e.target.checked);
    });
    const newDeleteButton = document.querySelector(`.delete-button[data-id="${tempId}"]`);
    newDeleteButton.addEventListener('click', () => {
      deleteItem(tempId);
    });
    updateProgressBar();
    updateChangesUI();
  }
  
  function updateProgressBar() {
    const completedCount = bucketListItems.filter(item => item.checked).length;
    const totalCount = bucketListItems.length;
    const percentage = (completedCount / totalCount) * 100;
    progressBar.style.width = `${percentage}%`;
    progressText.textContent = `${completedCount}/${totalCount} completed`;
  }
  
  function updateChangesUI() {
    if (pendingChanges.length > 0) {
      submitChangesButton.classList.remove('hidden');
      submitChangesButton.classList.remove('bg-dusk/50', 'text-dawn');
      submitChangesButton.classList.add('bg-sunrise', 'text-night');
      changesCount.textContent = pendingChanges.length;
      changesSummary.textContent = `${pendingChanges.length} pending change${pendingChanges.length > 1 ? 's' : ''}`;
      changesList.innerHTML = pendingChanges.map((change, index) => {
        let description = "";
        if (change.type === 'toggle') {
          description = `[${index + 1}] Marking "${change.label}" as ${change.checked ? 'completed' : 'incomplete'}`;
        } else if (change.type === 'delete') {
          description = `[${index + 1}] Deleting "${change.label}"`;
        } else if (change.type === 'add') {
          description = `[${index + 1}] Adding new item "${change.label}"`;
        }
        return `<div class="py-1 border-b border-dusk/30">${description}</div>`;
      }).join('');
    } else {
      submitChangesButton.classList.add('hidden');
      changesList.innerHTML = `<div class="text-center text-dawn/50 italic">No pending changes</div>`;
      changesSummary.textContent = 'No changes';
    }
  }
  
  function showPasswordPopup() {
    if (pendingChanges.length === 0) return;
    const popup = document.getElementById('password-popup');
    popup.classList.remove('hidden');
    setTimeout(() => {
      popup.classList.remove('translate-y-full');
    }, 10);
    passwordInput.focus();
  }
  
  function hidePasswordPopup() {
    const popup = document.getElementById('password-popup');
    popup.classList.add('translate-y-full');
    setTimeout(() => {
      popup.classList.add('hidden');
      passwordInput.value = '';
    }, 300);
  }
  
  function cancelChanges() {
    bucketListItems = JSON.parse(JSON.stringify(originalItems));
    bucketListContainer.innerHTML = "";
    originalItems.forEach((item) => {
      const itemHTML = createItemHTML(item, item.id);
      bucketListContainer.insertAdjacentHTML("beforeend", itemHTML);
    });
    document.querySelectorAll('.item-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const id = parseInt(e.target.dataset.id);
        toggleItem(id, e.target.checked);
      });
    });
    document.querySelectorAll('.delete-button').forEach(button => {
      button.addEventListener('click', (e) => {
        const id = parseInt(e.target.closest('.delete-button').dataset.id);
        deleteItem(id);
      });
    });
    pendingChanges = [];
    updateChangesUI();
    updateProgressBar();
    hidePasswordPopup();
  }
  
  async function submitChanges() {
    const password = passwordInput.value;
    if (!password) return;
    try {
      const response = await fetch('https://portfolio-backend.wishee.workers.dev', {
        method: 'POST',
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password, bucketListItems })
      });
      const data = await response.json();
      if (!response.ok) {
        showNotification(data.error || "Failed to save changes", "error");
        return;
      }
      originalItems = JSON.parse(JSON.stringify(bucketListItems));
      pendingChanges = [];
      updateChangesUI();
      hidePasswordPopup();
      showNotification("Changes saved successfully!", "success");
    } catch (error) {
      console.error("Error submitting changes:", error);
      showNotification("Failed to save changes", "error");
    }
  }
  
  function showNotification(message, type) {
    const notificationDiv = document.createElement("div");
    notificationDiv.className = `fixed top-4 right-4 px-4 py-2 rounded-lg text-sm z-50 transition-opacity duration-300 ${type === "error" ? "bg-red-500 text-white" : "bg-green-500 text-white"}`;
    notificationDiv.textContent = message;
    document.body.appendChild(notificationDiv);
    setTimeout(() => {
      notificationDiv.style.opacity = "0";
      setTimeout(() => {
        document.body.removeChild(notificationDiv);
      }, 300);
    }, 3000);
  }
  
  function createItemHTML(item, index) {
    return `
      <div class="flex items-center transition-all duration-300">
        <label class="block cursor-pointer flex-grow">
          <div class="group bg-dusk/30 hover:bg-dusk/50 rounded-lg px-4 py-3 transition-all duration-300 hover:-translate-x-2">
            <div class="flex items-center space-x-3">
              <input type="checkbox" ${item.checked ? "checked" : ""} data-id="${index}" class="item-checkbox w-4 h-4 rounded border-2 border-sunrise bg-transparent checked:bg-sunrise transition-colors duration-300" />
              <div class="flex items-center space-x-2 min-w-0">
                <span class="font-medium text-zenith ${item.checked ? "line-through opacity-50" : ""}">${item.label}</span>
                <span class="text-dawn opacity-50">•</span>
                <span class="text-sm text-dawn ${item.checked ? "line-through opacity-50" : ""}">${item.info}</span>
              </div>
            </div>
          </div>
        </label>
        <button class="delete-button ml-2 p-2 text-dawn hover:text-sunrise transition-colors" data-id="${index}" title="Delete item">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      </div>
    `;
  }
</script>
